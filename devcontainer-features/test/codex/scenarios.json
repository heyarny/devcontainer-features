{
  "link_folders": {
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "features": {
      "codex": {
        "version": "latest",
        "linkFolders": "sessions=/tmp/codex-sessions,archived_sessions=/tmp/codex-archived-sessions"
      }
    }
  },
  "custom_standalone_home": {
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "features": {
      "codex": {
        "version": "0.146.1",
        "standaloneHome": "/opt/codex-standalone",
        "linkFolders": "sessions=/tmp/codex-custom-sessions",
        "configSyncSource": "/tmp/codex-custom-config.toml"
      }
    }
  }
}
